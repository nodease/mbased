# ============================================================================
#                    📦 Moduly 환경 변수 설정 파일
# ============================================================================
# 이 파일을 복사하여 .env로 이름을 변경하고 실제 값을 입력하세요.
# $ cp .env.example .env
#
# ⚠️  주의: .env 파일은 절대로 Git에 커밋하지 마세요!
# ============================================================================


# ============================================================================
#                          🔐 보안 설정 (필수)
# ============================================================================

# JWT 토큰 서명에 사용되는 비밀키
# 🚨 프로덕션에서는 반드시 변경해야 합니다!
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# Password login abuse prevention
# Production에서는 32바이트 이상 key를 version별 JSON object로 Secret 주입합니다.
NODE_ENV=development
AUTH_LOGIN_FINGERPRINT_KEYS=
AUTH_LOGIN_FINGERPRINT_PRIMARY_VERSION=
AUTH_LOGIN_LIMITER_POLICY_VERSION=v1
AUTH_LOGIN_LIMITER_REDIS_DB=2
# Docker Nginx가 속한 실제 network CIDR에 맞게 조정합니다.
AUTH_LOGIN_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Connector test admission identity HMAC key
# Production에서는 32바이트 이상의 별도 값을 저장소 밖에서 생성·주입합니다.
# Development의 local-only fallback을 사용할 때만 비워 둡니다.
CONNECTOR_TEST_ADMISSION_HMAC_KEY=

# Public Conversation Memory stays disabled until all three independent keys
# and the backup crypto-erasure/no-backup contract are provisioned.
MEMORY_PUBLIC_CONVERSATION_ENABLED=false
MEMORY_PUBLIC_PURGE_WORKER_READY=false
MEMORY_PUBLIC_REPLAY_BACKUP_ERASURE_MODE=unconfirmed
MEMORY_PUBLIC_CAPABILITY_HMAC_KEY=
MEMORY_PUBLIC_CAPABILITY_HMAC_KEYS=
MEMORY_PUBLIC_CAPABILITY_HMAC_PRIMARY_VERSION=
MEMORY_PUBLIC_REPLAY_ENCRYPTION_KEY=
MEMORY_PUBLIC_REPLAY_ENCRYPTION_KEYS=
MEMORY_PUBLIC_REPLAY_ENCRYPTION_PRIMARY_VERSION=
MEMORY_PUBLIC_ADMISSION_HMAC_KEY=

# 예약·legacy 설정입니다. 현재 Docker Gateway와 LLM credential의
# encrypted_config 암호화에는 연결되지 않으므로 이 값을 설정해도 해당 저장 경로는 암호화되지 않습니다.
MASTER_KEY=

# 현재 shared/legacy 암호화 경로에 ENCRYPTION_KEY가 필요합니다.
# Fernet 호환 URL-safe Base64 32바이트 key 생성 예시:
# docker run --rm python:3.11-slim python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 생성한 key를 ENCRYPTION_KEY에 넣습니다. Mail/LLM keyring을 비우면 이 값을 v1 fallback으로 사용합니다.
ENCRYPTION_KEY=
# Mail versioned 방식: 별도 Fernet key를 JSON object로 설정하고 active version이 반드시 존재해야 합니다.
# 예: MAIL_CREDENTIAL_ENCRYPTION_KEYS={"v1":"<Fernet-key>"}
MAIL_CREDENTIAL_ENCRYPTION_KEYS=
MAIL_CREDENTIAL_ACTIVE_KEY_VERSION=v1
# Workflow node secret versioned keyring. Gateway와 Workflow Worker에 동일하게 주입합니다.
WORKFLOW_NODE_SECRET_ENCRYPTION_KEYS=
WORKFLOW_NODE_SECRET_ACTIVE_KEY_VERSION=v1
# LLM versioned 방식: Mail과 분리된 Fernet keyring을 Gateway와 Workflow Worker에 동일하게 주입합니다.
# 예: LLM_CREDENTIAL_ENCRYPTION_KEYS={"v1":"<Fernet-key>"}
LLM_CREDENTIAL_ENCRYPTION_KEYS=
LLM_CREDENTIAL_ACTIVE_KEY_VERSION=v1


# ============================================================================
#                        🗄️ 데이터베이스 설정
# ============================================================================
# Docker Compose에서 자동으로 주입되므로 일반적으로 수정할 필요 없음
# 로컬 개발 시 docker-compose.dev.yml의 postgres 서비스 사용

# PostgreSQL 연결 정보 (개별 항목)
# DB_HOST=localhost
# DB_PORT=5432
CONNECTOR_TEST_ALLOWED_PORTS=5432
# Docker Connector demo의 exact target과 CA는
# docker-compose.connector-demo.yml override가 소유합니다.
# CONNECTOR_TEST_LOCAL_PROFILE_ENABLED은 일반 Docker 환경에서 설정하지 않습니다.
# DB_USER=admin
# DB_PASSWORD=admin123
# DB_NAME=moduly

# 또는 전체 URL로 설정 (위 개별 항목보다 우선)
# DATABASE_URL=postgresql://admin:admin123@localhost:5432/moduly


# ============================================================================
#                        🏖️ 샌드박스 설정 (코드 실행)
# ============================================================================
# 코드 노드에서 Python 코드를 안전하게 실행하기 위한 샌드박스 서비스

# 샌드박스 서비스 URL (Docker Compose 내부에서는 자동 설정)
# SANDBOX_URL=http://sandbox:8194

# 워커 및 실행 설정
SANDBOX_MIN_WORKERS=2
SANDBOX_MAX_WORKERS=8
SANDBOX_DEFAULT_TIMEOUT=10
SANDBOX_MAX_PER_TENANT=3


# ============================================================================
#                          🌐 CORS 설정
# ============================================================================
# 프론트엔드에서 백엔드 API에 접근할 수 있는 출처(Origin) 목록
# 쉼표로 구분하여 여러 개 설정 가능

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ============================================================================
#                       💾 스토리지 설정 (필수)
# ============================================================================
# 파일 업로드 저장 위치를 선택합니다.
# 
# STORAGE_TYPE 옵션:
#   - LOCAL: 로컬 파일 시스템 사용 (기본값)
#            → 간단한 설정, AWS 계정 불필요
#            → Docker Compose 단독 실행 환경에 적합
#   - CLOUD: AWS S3 버킷 사용
#            → 확장 가능, 백업 용이
#            → 프로덕션 환경 권장
# 
STORAGE_TYPE=LOCAL


# ============================================================================
#                       ☁️ AWS S3 설정 (STORAGE_TYPE=CLOUD일 때 필수)
# ============================================================================
# STORAGE_TYPE 'CLOUD'로 설정한 경우에만 아래 설정이 필요합니다.

# AWS 자격 증명
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# S3 버킷 이름 (파일 업로드 저장소)
S3_BUCKET_NAME=

# LlamaCloud API 키 (Optional)
# https://cloud.llamaindex.ai/ 에서 발급받을 수 있습니다
LLAMA_CLOUD_API_KEY=


# ============================================================================
#                        🔧 기타 설정
# ============================================================================

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# 타임존 (스케줄러, 로그 등에 사용)
TZ=Asia/Seoul
# Durable schedule dispatch. Keep disabled until the migration-first rollout.
SCHEDULE_DISPATCH_MODE=disabled
# App secret issuance/rotation remains read-only until every Gateway instance
# runs the verifier-aware revision. Use active only after that convergence check.
APP_AUTH_SECRET_LIFECYCLE_MODE=disabled
SCHEDULE_DISPATCH_POLL_SECONDS=5
SCHEDULE_OCCURRENCE_BATCH_SIZE=50
SCHEDULE_DISPATCH_BATCH_SIZE=10
SCHEDULE_RECOVERY_BATCH_SIZE=50
SCHEDULE_CLEANUP_BATCH_SIZE=100
SCHEDULE_DISPATCH_LEASE_SECONDS=60
SCHEDULE_ENQUEUED_DELIVERY_TIMEOUT_SECONDS=120
SCHEDULE_EXECUTION_DEADLINE_SECONDS=900
SCHEDULE_WORKFLOW_RUN_VISIBILITY_TIMEOUT_SECONDS=120
SCHEDULE_DISPATCH_MAX_ATTEMPTS=5
SCHEDULE_DISPATCH_RETRY_BASE_SECONDS=5
SCHEDULE_DISPATCH_RETENTION_DAYS=30
SCHEDULE_DISPATCH_DEAD_LETTER_RETENTION_DAYS=180
