# ==============================================
# Gateway & Backend Core Settings
# ==============================================

# RAG 데이터 수집 모드 (LOCAL: 로컬용, CLOUD: 운영용)
STORAGE_TYPE=LOCAL

# 민감 데이터 암호화를 위한 마스터 키 (필수)
# 32바이트(256비트) 랜덤 키를 Base64로 인코딩한 값이어야 합니다.
# 생성 명령: openssl rand -base64 32
MASTER_KEY=
ENCRYPTION_KEY=
MAIL_CREDENTIAL_ENCRYPTION_KEYS=
MAIL_CREDENTIAL_ACTIVE_KEY_VERSION=v1
WORKFLOW_NODE_SECRET_ENCRYPTION_KEYS=
WORKFLOW_NODE_SECRET_ACTIVE_KEY_VERSION=v1
LLM_CREDENTIAL_ENCRYPTION_KEYS=
LLM_CREDENTIAL_ACTIVE_KEY_VERSION=v1

# Public Conversation Memory activation gate.
MEMORY_PUBLIC_CONVERSATION_ENABLED=false
MEMORY_PUBLIC_PURGE_WORKER_READY=false
MEMORY_PUBLIC_REPLAY_BACKUP_ERASURE_MODE=unconfirmed
MEMORY_PUBLIC_CAPABILITY_HMAC_KEY=
MEMORY_PUBLIC_CAPABILITY_HMAC_KEYS=
MEMORY_PUBLIC_CAPABILITY_HMAC_PRIMARY_VERSION=
MEMORY_PUBLIC_REPLAY_ENCRYPTION_KEY=
MEMORY_PUBLIC_REPLAY_ENCRYPTION_KEYS=
MEMORY_PUBLIC_REPLAY_ENCRYPTION_PRIMARY_VERSION=
MEMORY_PUBLIC_ADMISSION_HMAC_KEY=

# API Security
# JWT 서명 등에 사용되는 비밀키
SECRET_KEY=your-secret-key-change-in-production
# Llama Cloud API 키
LLAMA_CLOUD_API_KEY=
# Node Environment (development, production)
NODE_ENV=development

# CORS & Cookie Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_DOMAIN=

# AWS 설정 (선택 사항 - S3 등을 사용할 경우 설정)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# ==============================================
# Authentication (Google OAuth)
# ==============================================
# Google Cloud Console에서 발급받은 OAuth 2.0 클라이언트 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================
# Database & Redis Settings
# ==============================================
# Docker Compose 사용 시 기본값 유지 (로컬 개발용)
POSTGRES_SERVER=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=moduly_local

# DB Connection Details (Explicit)
DB_HOST=localhost
DB_PORT=5432
CONNECTOR_TEST_ALLOWED_PORTS=5432,55432
# Host-run Gateway에서 connector-demo profile을 사용할 때만 활성화합니다.
# CONNECTOR_TEST_LOCAL_PROFILE_ENABLED=true
# CONNECTOR_TEST_TRUSTED_LOCAL_TARGETS=localhost:55432
# CONNECTOR_TEST_TRUSTED_LOCAL_CA_FILE=local/connector-test-tls/dev/ca.crt
# CONNECTOR_TEST_REDIS_URL=redis://localhost:56379/15
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=moduly_local

# Gateway와 worker를 host process로 실행하므로 localhost를 사용합니다.
# Container 내부 설정은 docker/.env.example과 docker/docker-compose.yml이 소유합니다.
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Password login abuse prevention (Redis logical DB 2)
AUTH_LOGIN_LIMITER_REDIS_DB=2
AUTH_LOGIN_LIMITER_POLICY_VERSION=v1
# Host에서 Gateway를 직접 실행할 때는 비워 forwarded header를 무시합니다.
AUTH_LOGIN_TRUSTED_PROXY_CIDRS=
# Production에서는 Secret으로 dedicated versioned keyring을 주입해야 합니다.
AUTH_LOGIN_FINGERPRINT_KEYS=
AUTH_LOGIN_FINGERPRINT_PRIMARY_VERSION=

# ==============================================
# Client (Next.js) Settings
# ==============================================
# 백엔드 API URL (브라우저에서 접근 가능한 주소)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================
# Load Testing (Locust) Settings
# ==============================================
# 부하 테스트 시 사용할 워크플로우 식별자 (Slug)
LOAD_TEST_DEPLOYMENT_SLUG=
# 부하 테스트 시 사용할 인증 토큰 (Authorization: Bearer 헤더 값)
LOAD_TEST_AUTH_TOKEN=
